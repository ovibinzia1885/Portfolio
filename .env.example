SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Dhaka
# Production: DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

